# Slack AppのIncoming Webhook URLを設定してください。値は公開リポジトリに保存しないでください。
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/THIS/VALUE

# 編集画面で設定を保存するため、Vercel Blobをこのプロジェクトに接続して発行される値を設定します。
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE_THIS_VALUE

# 推測されにくい、十分に長い編集用パスワードを設定します。
ADMIN_SECRET=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
