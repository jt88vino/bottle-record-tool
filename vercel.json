{
  "version": 2,
  "crons": [
    {
      "path": "/api/shipments",
      "schedule": "0 23 * * *"
    }
  ],
  "functions": {
    "api/report.js": {
      "maxDuration": 60
    },
    "api/history.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "https://hw-app-sepia.vercel.app/$1"
    }
  ]
}
