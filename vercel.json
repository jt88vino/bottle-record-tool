{
  "version": 2,
  "rewrites": [
    {
      "source": "/shipments",
      "destination": "/shipments.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/shipments",
      "schedule": "0 23 * * *"
    }
  ],
  "functions": {
    "api/report.js": {
      "maxDuration": 60
    },
    "api/history.js": {
      "maxDuration": 60
    }
  }
}
